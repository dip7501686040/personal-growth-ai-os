# ─────────────────────────────────────────────────────────────────────────────
# Personal Growth AI OS — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection for Drizzle (Project Settings → Database → Connection string)
# App runtime: use the Transaction pooler URI (port 6543). Add ?pgbouncer=true.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: use the Session pooler / direct URI (port 5432). Optional.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public base URL of the app (used to build the magic-link redirect).
# On Vercel you can leave this unset — it derives from VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# Single-user app: only these emails may sign in (comma-separated).
ALLOWED_EMAILS=you@example.com

# ── Added in later phases (leave blank for Phase 1) ──────────────────────────
# AI providers (Phase 3+). Agents fall back to a deterministic plan without a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Vercel Cron shared secret (Phase 3+). Vercel sends it as `Authorization: Bearer`.
CRON_SECRET=
# The owner's auth.users id (stable) — lets cron skip an auth-schema lookup.
OWNER_USER_ID=
# Local activity collector → ingestion API bearer token (Phase 2.5)
INGEST_TOKEN=
