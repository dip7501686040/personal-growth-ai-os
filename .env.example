# ─────────────────────────────────────────────────────────────────────────────
# Personal Growth AI OS — environment
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection for Drizzle (Project Settings → Database → Connection string)
# App runtime: use the Transaction pooler URI (port 6543). Add ?pgbouncer=true.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations: use the Session pooler / direct URI (port 5432). Optional.
DIRECT_URL=postgresql://postgres.YOUR-PROJECT-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Public base URL of the app (used to build the magic-link redirect).
# On Vercel you can leave this unset — it derives from VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# Single-user app: only these emails may sign in (comma-separated).
ALLOWED_EMAILS=you@example.com

# ── Added in later phases (leave blank for Phase 1) ──────────────────────────
# AI providers (Phase 3+). Agents fall back to a deterministic plan without a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Anthropic — enables the in-app "Preferred model" = Sonnet 5 (Track A). Optional.
ANTHROPIC_API_KEY=
# Quota estimates shown in the run console (optional overrides).
# Gemini free tier — VERIFY at https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_FREE_RPM=10
GEMINI_FREE_TPM=250000
GEMINI_FREE_RPD=250
# OpenAI one-time usage credit in USD
OPENAI_BUDGET_USD=5
# Vercel Cron shared secret (Phase 3+). Vercel sends it as `Authorization: Bearer`.
CRON_SECRET=
# The owner's auth.users id (stable) — lets cron skip an auth-schema lookup.
OWNER_USER_ID=
# Local activity collector → ingestion API bearer token (Phase 2.5)
INGEST_TOKEN=

# ── Track J: job-application automation ──────────────────────────────────────
# Job-search sources. All optional — `pnpm jobs` uses a source only when its key
# is present and reports the rest as "skipped". Keyless sources (RemoteOK,
# Remotive, WeWorkRemotely, HN) always run.
JSEARCH_API_KEY=          # RapidAPI → jsearch (free ~200/mo)
ADZUNA_APP_ID=            # https://developer.adzuna.com/ (needs id + key)
ADZUNA_APP_KEY=
SERPAPI_KEY=              # https://serpapi.com/ google_jobs (free ~100/mo)
# GitHub PAT for the repo connector + proof-link resolution. Read-only scopes;
# blank works for public repos (60 req/hr).
GITHUB_TOKEN=
# Knowledge-base embedding backend: auto | gemini | local. Default auto.
EMBEDDINGS_PROVIDER=

# Cloudflare R2 (S3-compatible) — source of truth for the applications/ tree.
# Dashboard → R2 → Manage R2 API Tokens → create an Account token with
# Object Read & Write, scoped to the `applications` bucket. Use the Access Key
# ID / Secret pair it shows (not the "Token value").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=applications
# Second bucket, same account — source of truth for resume/ (master résumé,
# profile, job-search config, media manifest). Create it the same way as
# `applications`.
R2_FILES_BUCKET=my-files

# Cloudinary — visual proof (demo videos / screenshots / diagrams). From the
# Cloudinary dashboard "API Environment variable". Format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ── Content generation (Group A): UI-screenshot capture ───────────────────────
# One login pair per tracked project that has a liveUrl set (see /projects).
# A Claude Code session reads these to drive Playwright's login before
# `pnpm content browser` — the Next.js app itself never touches them.
PGAI_LOGIN_EMAIL=
PGAI_LOGIN_PASSWORD=
AI_NOTIFICATION_SYSTEM_EMAIL=
AI_NOTIFICATION_SYSTEM_PASSWORD=
