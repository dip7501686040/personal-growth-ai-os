{
  "mcpServers": {
    "personal-context": {
      "command": "node",
      "args": [
        "--import",
        "tsx",
        "--env-file=.env.local",
        "mcp/server.ts"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.80",
        "--browser",
        "chromium",
        "--output-dir",
        ".apply-drive",
        "--user-data-dir",
        "~/.config/pgai/playwright-profile"
      ]
    }
  }
}
