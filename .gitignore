# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed)
.env
.env.local
.env.*.local

# vercel
.vercel

# local activity collector queue
/collector/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# résumé + applications data — R2 is the source of truth (my-files /
# applications buckets), not git. See README.md "Résumé + applications data".
# profile.example.json is the one exception, kept as a committed template.
/resume/*
!/resume/profile.example.json

# Playwright MCP output (screenshots the apply-drive skill copies into folders)
.apply-drive/

# scratch output for terminal-card rendering (Group A)
.scratch/

# generated per-job application folders (ledger is in the DB) — root only,
# not src/**/applications which is real source
/applications/
