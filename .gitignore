# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example committed)
.env
.env.local
.env.*.local

# vercel
.vercel

# local activity collector queue
/collector/data/

# typescript
*.tsbuildinfo
next-env.d.ts

# generated résumé output (source is resume/master.json)
resume/out/

# standing answer bank for application forms (copy from profile.example.json)
resume/profile.json

# generated per-job application folders (ledger is in the DB) — root only,
# not src/**/applications which is real source
/applications/
