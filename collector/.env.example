# Copy to collector/.env (gitignored) and fill in.
# Generate the token in the app: Activity page → Collector setup → Generate token.
PGAIOS_INGEST_TOKEN=

# Optional overrides
PGAIOS_API_BASE_URL=https://personal-growth-ai-os-teal.vercel.app
PGAIOS_DEBUG=0

# Opt-in: also ship trimmed Claude Code conversation text (user + assistant
# prose only) for knowledge extraction. Off by default — this sends more than
# the metadata-only activity events. One-time backfill of past sessions:
#   node collector/src/index.ts transcripts --backfill
PGAIOS_SYNC_TRANSCRIPTS=0
